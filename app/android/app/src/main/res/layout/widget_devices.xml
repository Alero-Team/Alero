<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/w_pill" android:padding="9dp" android:src="@drawable/ic_w_laptop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Dispositivos" android:textColor="@color/w_on" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/w_tile" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:visibility="gone">
        <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_on" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/state1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_muted" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/w_tile" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:visibility="gone">
        <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_on" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/state2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_muted" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/w_tile" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:visibility="gone">
        <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_on" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/state3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_muted" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ningún ordenador emparejado todavía. Toca para emparejar." android:textColor="@color/w_muted" android:textSize="13sp" />
</LinearLayout>
